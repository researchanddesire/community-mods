# Print/CAD binaries go through Git LFS to keep clones lean.
*.stl filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
*.f3d filter=lfs diff=lfs merge=lfs -text
*.f3z filter=lfs diff=lfs merge=lfs -text
*.FCStd filter=lfs diff=lfs merge=lfs -text
*.fcstd filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.scad.stl filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Keep the gallery build independent of LFS availability.
.github/workflows/scripts/assets/** -filter -diff -merge -text
mods/**/img/** -filter -diff -merge -text

# Small Remote Clip downloads are stored directly in Git (maintainer exception).
mods/ossm/ossm-remote-clip/cad/*.step -filter -diff -merge -text
mods/ossm/ossm-remote-clip/print/*.stl -filter -diff -merge -text

# Keep the portable bedframe CAD source archive with its design binaries.
mods/ossm/bedframe-pitclamp-adapter/cad/*.zip filter=lfs diff=lfs merge=lfs -text
